/* ======================================
   APP STATE
====================================== */

let current = 0;
let affection = 50;
let memories = [];
let choicesMade = {};
let messages = [
 {from:"him",text:"생일 축하해 ♡"},
 {from:"him",text:"오늘 하루는 내가 다 예약했으니까 기대해."},
 {from:"him",text:"빨리 보고 싶다."}
];

const $ = id => document.getElementById(id);

function saveState(){
  try{
    localStorage.setItem("sakuyaBirthday",JSON.stringify({
      current,affection,memories,choicesMade,messages
    }));
  }catch(e){}
}

function loadState(){
  try{
    const saved=JSON.parse(localStorage.getItem("sakuyaBirthday"));
    if(saved){
      current=Math.min(Math.max(saved.current||0,0),chapters.length-1);
      affection=saved.affection??50;
      memories=saved.memories||[];
      choicesMade=saved.choicesMade||{};
      messages=saved.messages||messages;
    }
  }catch(e){}
}

/* ======================================
   STORY RENDER
====================================== */

function renderStory(){
  const c=chapters[current];

  $("chapterNumber").textContent=
    "CHAPTER "+String(current+1).padStart(2,"0");

  $("chapterTag").textContent=c.tag;
  $("chapterTitle").textContent=c.title;
  $("location").textContent=c.time+"  ─  "+c.place;
  $("storyText").innerHTML=c.story.split("\n\n")
    .map(p=>`<p>${escapeHTML(p).replace(/\n/g,"<br>")}</p>`)
    .join("");

  $("clock").textContent=c.time;
  $("clockLabel").textContent=c.label;

  $("progressText").textContent=
    (current+1)+" / 22 CHAPTERS";

  $("progressFill").style.width=
    ((current+1)/chapters.length*100)+"%";

  $("prevBtn").disabled=current===0;
  $("nextBtn").textContent=
    current===chapters.length-1?"오늘의 이야기 다시 보기 ↻":"다음 장면 →";

  renderChoices();
  renderAffection();
  renderSchedule();
  renderMemories();
  renderGift();
  saveState();
}

function escapeHTML(str){
  return str.replace(/[&<>"']/g,c=>({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[c]);
}

function renderChoices(){
  const c=chapters[current];
  const area=$("choices");
  const result=$("choiceResult");

  area.innerHTML="";
  result.style.display="none";

  if(choicesMade[current]!==undefined){
    const selected=choicesMade[current];
    const choice=c.choices[selected];

    area.innerHTML=`
      <button class="choice selected" disabled>
        ✓ ${escapeHTML(choice[0])}
      </button>`;
    result.innerHTML=escapeHTML(choice[1]);
    result.style.display="block";
    return;
  }

  c.choices.forEach((choice,index)=>{
    const btn=document.createElement("button");
    btn.className="choice";
    btn.textContent=choice[0];
    btn.onclick=()=>selectChoice(index);
    area.appendChild(btn);
  });
}

function selectChoice(index){
  if(choicesMade[current]!==undefined)return;

  const c=chapters[current];
  const choice=c.choices[index];

  choicesMade[current]=index;
  affection=Math.min(100,Math.max(0,affection+choice[2]));

  if(!memories.includes(c.memory)){
    memories.push(c.memory);
  }

  $("choiceResult").textContent=choice[1];
  $("choiceResult").style.display="block";

  renderChoices();
  renderAffection();
  renderMemories();
  saveState();
}

function nextChapter(){
  if(current===chapters.length-1){
    current=0;
    renderStory();
    return;
  }

  if(choicesMade[current]===undefined){
    showModal("잠깐 ♡","이 장면의 선택지를 먼저 골라 줘.\n어떤 선택을 하느냐에 따라 우리의 추억이 달라져.");
    return;
  }

  current++;
  renderStory();
  showTab("storyPanel",document.querySelectorAll(".tab")[0]);
  window.scrollTo({top:0,behavior:"smooth"});
  automaticMessage();
}

function previousChapter(){
  if(current>0){
    current--;
    renderStory();
    window.scrollTo({top:0,behavior:"smooth"});
  }
}

function renderAffection(){
  $("affectionText").textContent="♥ "+affection;
  $("affectionBar").style.width=affection+"%";
}

/* ======================================
   SCHEDULE
====================================== */

function renderSchedule(){
  $("scheduleList").innerHTML=chapters.map((c,i)=>{
    let status="";
    let cls="";

    if(i<current){
      status="✓ 완료";
    }else if(i===current){
      status="● 진행 중";
      cls="current";
    }else{
      status="예정";
      cls="locked";
    }

    return `
      <div class="schedule-item ${cls}" onclick="goToChapter(${i})">
        <div class="schedule-time">${c.time}</div>
        <div class="schedule-info">
          <div class="schedule-name">${c.title}</div>
          <div class="schedule-place">${c.place}</div>
        </div>
        <div class="schedule-status">${status}</div>
      </div>`;
  }).join("");
}

function goToChapter(index){
  if(index>current){
    showModal("아직 열리지 않은 일정","현재 장면을 진행한 뒤 다음 일정을 확인할 수 있어.");
    return;
  }
  current=index;
  renderStory();
  showTab("storyPanel",document.querySelectorAll(".tab")[0]);
}

/* ======================================
   MEMORIES & GIFTS
====================================== */

function renderMemories(){
  if(memories.length===0){
    $("memoryList").innerHTML=`
      <div class="empty">
        아직 기록된 추억이 없어.<br>
        데이트를 진행하면서 추억을 모아 봐 ♡
      </div>`;
    return;
  }

  $("memoryList").innerHTML=memories.map((m,i)=>`
    <div class="memory-item">
      <h4>♡ MEMORY ${String(i+1).padStart(2,"0")}</h4>
      <p>${escapeHTML(m)}</p>
    </div>
  `).join("");
}

function renderGift(){
  if(current>=14){
    $("giftDescription").style.display="none";
    $("giftUnlocked").style.display="block";
  }else{
    $("giftDescription").style.display="block";
    $("giftUnlocked").style.display="none";
  }
}

/* ======================================
   CHAT SYSTEM
====================================== */

function renderChat(){
  const screen=$("chatScreen");
  screen.innerHTML='<div class="date-divider">TODAY ♡</div>';

  messages.forEach(msg=>{
    const bubble=document.createElement("div");
    bubble.className="bubble "+(msg.from==="me"?"me":"him");
    bubble.textContent=msg.text;
    screen.appendChild(bubble);
  });

  screen.scrollTop=screen.scrollHeight;
}

function sendChat(){
  const input=$("chatInput");
  const text=input.value.trim();
  if(!text)return;

  messages.push({from:"me",text});
  input.value="";
  renderChat();
  saveState();

  setTimeout(()=>{
    const replies=[
      "ㅋㅋㅋㅋ 귀여워.",
      "나도 그렇게 생각했어.",
      "보고 싶다.",
      "오늘 정말 좋았어.",
      "왜 이렇게 사랑스럽지.",
      "응. 나 여기 있어.",
      "오늘 사진 또 보내 줄까?",
      "사랑해 ♡"
    ];
    const reply=replies[Math.floor(Math.random()*replies.length)];
    messages.push({from:"him",text:reply});
    renderChat();
    saveState();
  },700);
}

function quickChat(text){
  $("chatInput").value=text;
  sendChat();
}

function automaticMessage(){
  const msgs=[
    "다음 장소로 가자. 준비됐어?",
    "오늘 너랑 있으니까 시간이 너무 빠르다.",
    "아까 찍은 사진 보내 줄까?",
    "지금 뭐 하고 있어? 나는 네 생각 중.",
    "오늘 정말 행복해.",
    "조금만 더 같이 있자."
  ];
  messages.push({
    from:"him",
    text:msgs[Math.min(current-1,msgs.length-1)]
  });
  renderChat();
  saveState();
}

/* ======================================
   TABS
====================================== */

function showTab(panel,button){
  document.querySelectorAll(".panel").forEach(p=>p.classList.remove("active"));
  document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));

  $(panel).classList.add("active");
  if(button)button.classList.add("active");

  if(panel==="chatPanel")renderChat();
  if(panel==="schedulePanel")renderSchedule();
  if(panel==="memoryPanel")renderMemories();
  if(panel==="giftPanel")renderGift();

  window.scrollTo({top:0,behavior:"smooth"});
}

/* ======================================
   MODAL
====================================== */

function showModal(title,text){
  $("modalTitle").textContent=title;
  $("modalText").textContent=text;
  $("modal").classList.add("show");
}

function closeModal(){
  $("modal").classList.remove("show");
}

/* ======================================
   PHONE CALL
====================================== */

function callSakuya(){
  showModal("📞 사쿠야에게 전화하기",
    "사쿠야에게 전화를 걸고 있어...\n\n사쿠야: 여보세요?\n\n\"응, 왜? 목소리 듣고 싶었어?\"\n\n그는 웃으며 전화를 받았다.");
}

/* ======================================
   INITIALIZE
====================================== */

loadState();
renderStory();
renderChat();

</script>
</body>
</html>
