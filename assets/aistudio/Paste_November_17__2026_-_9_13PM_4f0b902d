
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f8eaf0">
<title>A DAY WITH SAKUYA ♡</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Playfair+Display:wght@400;500;600&display=swap');

:root {
  --pink:#e9b9cc;
  --deep:#a86e87;
  --light:#fff7fa;
  --pale:#f8eaf0;
  --text:#59434c;
  --muted:#a58c96;
  --line:#f0dce5;
  --white:#fff;
}

*{box-sizing:border-box}
body{
  margin:0;
  background:#f5edf0;
  color:var(--text);
  font-family:'Gowun Dodum',sans-serif;
}
button{font-family:inherit;cursor:pointer}
button:focus-visible{outline:2px solid var(--deep)}
.app{
  max-width:480px;
  min-height:100vh;
  margin:auto;
  background:var(--light);
  position:relative;
  padding-bottom:85px;
  box-shadow:0 0 35px #b88b9a22;
}
.header{
  padding:22px 22px 17px;
  background:linear-gradient(135deg,#f9e8ef,#f5dce7);
  position:relative;
}
.header-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:11px;
  letter-spacing:2px;
  color:var(--deep);
}
.live{
  border:1px solid #d5a4b9;
  border-radius:20px;
  padding:4px 10px;
  letter-spacing:1px;
}
.logo{
  text-align:center;
  padding:22px 0 17px;
}
.logo .small{
  font-size:10px;
  letter-spacing:3px;
  color:var(--deep);
}
.logo h1{
  font-family:'Playfair Display',serif;
  font-size:32px;
  font-weight:500;
  color:#815269;
  margin:8px 0;
}
.logo p{font-size:12px;color:#a77d90;margin:0}
.progress-area{margin-top:12px}
.progress-info{
  display:flex;
  justify-content:space-between;
  font-size:11px;
  color:#9c7286;
  margin-bottom:7px;
}
.progress{
  height:5px;
  background:#e9cdd9;
  border-radius:10px;
  overflow:hidden;
}
.progress-fill{
  height:100%;
  background:#b87997;
  transition:.4s;
  width:0%;
}
.timebar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:14px 20px;
  background:white;
  border-bottom:1px solid var(--line);
}
.timebar strong{
  font-family:'Playfair Display',serif;
  font-size:23px;
  color:#9c657f;
}
.timebar span{font-size:11px;color:var(--muted)}
.content{padding:18px}
.section-label{
  font-size:10px;
  letter-spacing:2px;
  color:#bd8ba0;
  margin-bottom:9px;
}
.card{
  background:white;
  border:1px solid var(--line);
  border-radius:15px;
  padding:17px;
  margin-bottom:14px;
}
.chapter-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:12px;
}
.chapter-number{
  font-size:10px;
  letter-spacing:2px;
  color:#bd8ba0;
}
.chapter-tag{
  font-size:10px;
  padding:5px 9px;
  border-radius:20px;
  background:#f8eaf0;
  color:#a36d84;
}
.chapter-title{
  font-size:21px;
  line-height:1.5;
  color:#785267;
  margin:5px 0 15px;
  font-weight:normal;
}
.story{
  font-size:14px;
  line-height:2.05;
  color:#67545d;
  white-space:pre-line;
  word-break:keep-all;
}
.story p{margin:0 0 15px}
.story .dialogue{
  color:#a46d84;
  font-weight:bold;
}
.story .emphasis{
  color:#a36d84;
  font-weight:bold;
}
.location{
  font-size:11px;
  color:#ae8a99;
  margin-bottom:12px;
}
.choice-area{margin-top:20px}
.choice-title{
  font-size:12px;
  color:#a36d84;
  margin-bottom:10px;
}
.choice{
  display:block;
  width:100%;
  text-align:left;
  border:1px solid #ead5df;
  border-radius:10px;
  padding:13px;
  margin:8px 0;
  color:#765969;
  background:#fff9fb;
  font-size:13px;
  transition:.2s;
}
.choice:hover,.choice.selected{
  background:#f5e1e9;
  border-color:#ce9eb4;
}
.choice-result{
  margin-top:12px;
  padding:13px;
  background:#f9edf2;
  border-radius:10px;
  font-size:13px;
  line-height:1.8;
  display:none;
}
.navigation{
  display:flex;
  gap:9px;
  margin-top:20px;
}
.nav-btn{
  flex:1;
  border:1px solid #e8ceda;
  border-radius:10px;
  background:white;
  color:#98677e;
  padding:13px 5px;
  font-size:12px;
}
.nav-btn.primary{
  background:#b77b96;
  border-color:#b77b96;
  color:white;
}
.nav-btn:disabled{opacity:.35;cursor:not-allowed}
.bottom-nav{
  position:fixed;
  bottom:0;
  left:50%;
  transform:translateX(-50%);
  width:100%;
  max-width:480px;
  display:grid;
  grid-template-columns:repeat(5,1fr);
  background:#fff;
  border-top:1px solid var(--line);
  padding:10px 5px calc(10px + env(safe-area-inset-bottom));
  z-index:10;
}
.tab{
  background:none;
  border:0;
  color:#b49ba6;
  font-size:10px;
  display:flex;
  flex-direction:column;
  gap:5px;
  align-items:center;
}
.tab .ico{font-size:20px}
.tab.active{color:#a96d86}
.panel{display:none}
.panel.active{display:block}
.chat-head{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px;
  background:#fff;
  border:1px solid var(--line);
  border-radius:13px;
  margin-bottom:15px;
}
.avatar{
  width:42px;height:42px;
  border-radius:50%;
  background:#f0d9e3;
  display:grid;
  place-items:center;
  color:#a46c83;
  font-size:18px;
}
.chat-name{font-size:14px;font-weight:bold}
.chat-status{font-size:10px;color:#a68b97;margin-top:3px}
.chat-screen{
  background:#f4edf0;
  border-radius:13px;
  padding:14px 10px;
  min-height:300px;
  display:flex;
  flex-direction:column;
  gap:12px;
}
.date-divider{
  text-align:center;
  font-size:10px;
  color:#a18b95;
  margin:5px;
}
.bubble{
  max-width:80%;
  padding:10px 12px;
  font-size:13px;
  line-height:1.7;
  border-radius:12px;
  white-space:pre-line;
  word-break:keep-all;
}
.bubble.him{
  align-self:flex-start;
  background:white;
  border-top-left-radius:3px;
}
.bubble.me{
  align-self:flex-end;
  background:#f4dce6;
  border-top-right-radius:3px;
}
.chat-input{
  display:flex;
  gap:7px;
  margin-top:12px;
}
.chat-input input{
  flex:1;
  min-width:0;
  border:1px solid var(--line);
  border-radius:20px;
  padding:11px 14px;
  background:white;
  outline:none;
  font-family:inherit;
  font-size:13px;
}
.chat-input button{
  border:0;
  background:#b77b96;
  color:white;
  border-radius:20px;
  padding:0 16px;
}
.quick-replies{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-top:12px;
}
.quick-replies button{
  border:1px solid #e6cbd7;
  background:white;
  color:#9d6b82;
  border-radius:20px;
  padding:8px 12px;
  font-size:11px;
}
.schedule-item{
  display:flex;
  gap:13px;
  padding:14px 0;
  border-bottom:1px solid var(--line);
  cursor:pointer;
}
.schedule-item:last-child{border:0}
.schedule-time{
  width:52px;
  font-size:12px;
  color:#b17b93;
  flex-shrink:0;
}
.schedule-info{flex:1}
.schedule-name{font-size:13px;color:#775567}
.schedule-place{font-size:10px;color:#ac929e;margin-top:4px}
.schedule-status{font-size:10px;color:#c1aab4}
.schedule-item.current .schedule-name{font-weight:bold;color:#a46b83}
.schedule-item.locked{opacity:.4}
.memory-item{
  background:white;
  border:1px solid var(--line);
  border-radius:12px;
  padding:14px;
  margin-bottom:10px;
}
.memory-item h4{margin:0 0 6px;font-size:13px;color:#9c6980}
.memory-item p{font-size:12px;line-height:1.8;color:#816d76;margin:0}
.gift{
  text-align:center;
  padding:24px 15px;
}
.gift-icon{font-size:45px;margin:12px}
.gift h3{font-size:17px;color:#86566d;font-weight:normal}
.gift p{font-size:12px;line-height:1.9;color:#927986}
.empty{padding:40px 15px;text-align:center;color:#b59ca7;font-size:13px;line-height:2}
.modal-bg{
  display:none;
  position:fixed;
  inset:0;
  background:#3e283566;
  z-index:20;
  align-items:center;
  justify-content:center;
  padding:20px;
}
.modal-bg.show{display:flex}
.modal{
  background:#fff8fb;
  border-radius:18px;
  width:100%;
  max-width:360px;
  padding:25px;
  text-align:center;
}
.modal h2{font-weight:normal;color:#86566d}
.modal p{font-size:13px;line-height:1.9;color:#856e79;white-space:pre-line}
.modal button{
  background:#b77b96;
  border:0;
  color:white;
  border-radius:10px;
  padding:12px 25px;
  margin-top:15px;
}
.heart-meter{
  display:flex;
  align-items:center;
  justify-content:space-between;
  font-size:12px;
  color:#a36e85;
  margin:12px 0;
}
.heart-meter span{font-size:17px}
.footer-note{
  text-align:center;
  color:#c0a5b2;
  font-size:10px;
  margin:25px 0;
}
@media(min-width:481px){
  body{padding:20px 0}
  .app{border-radius:20px;overflow:hidden}
  .bottom-nav{bottom:20px;border-radius:0 0 20px 20px}
}
</style>
</head>

<body>
<div class="app">

<header class="header">
  <div class="header-top">
    <span>♡ BIRTHDAY SPECIAL</span>
    <span class="live">● LIVE DATE</span>
  </div>
  <div class="logo">
    <div class="small">A SPECIAL DAY WITH YOU</div>
    <h1>A DAY WITH SAKUYA</h1>
    <p>너의 생일, 우리 둘만의 하루</p>
  </div>
  <div class="progress-area">
    <div class="progress-info">
      <span>OUR STORY</span>
      <span id="progressText">0 / 22 CHAPTERS</span>
    </div>
    <div class="progress">
      <div class="progress-fill" id="progressFill"></div>
    </div>
  </div>
</header>

<div class="timebar">
  <div>
    <span>OUR TIME</span><br>
    <strong id="clock">08:00</strong>
  </div>
  <div style="text-align:right">
    <span id="clockLabel">BIRTHDAY MORNING</span><br>
    <span>November · Tokyo ♡</span>
  </div>
</div>

<main class="content">

<!-- STORY -->
<section class="panel active" id="storyPanel">
  <div class="section-label">TODAY'S STORY</div>
  <div class="card">
    <div class="chapter-top">
      <span class="chapter-number" id="chapterNumber">CHAPTER 01</span>
      <span class="chapter-tag" id="chapterTag">BIRTHDAY</span>
    </div>
    <div class="location" id="location"></div>
    <h2 class="chapter-title" id="chapterTitle"></h2>
    <div class="story" id="storyText"></div>

    <div class="choice-area" id="choiceArea">
      <div class="choice-title">♡ 어떻게 할까?</div>
      <div id="choices"></div>
      <div class="choice-result" id="choiceResult"></div>
    </div>

    <div class="navigation">
      <button class="nav-btn" id="prevBtn" onclick="previousChapter()">← 이전</button>
      <button class="nav-btn primary" id="nextBtn" onclick="nextChapter()">다음 장면 →</button>
    </div>
  </div>

  <div class="card">
    <div class="section-label">RELATIONSHIP STATUS</div>
    <div class="heart-meter">
      <span>SAKUYA ♥</span>
      <span id="affectionText">♡ 50</span>
    </div>
    <div class="progress">
      <div class="progress-fill" id="affectionBar" style="width:50%"></div>
    </div>
    <p style="font-size:10px;color:#b39ba6;margin:10px 0 0">
      오늘의 선택들이 우리의 추억이 돼.
    </p>
  </div>
</section>

<!-- CHAT -->
<section class="panel" id="chatPanel">
  <div class="section-label">PRIVATE MESSAGE</div>
  <div class="chat-head">
    <div class="avatar">♡</div>
    <div>
      <div class="chat-name">사쿠야</div>
      <div class="chat-status">online · 너의 남자친구</div>
    </div>
  </div>
  <div class="chat-screen" id="chatScreen">
    <div class="date-divider">TODAY ♡</div>
    <div class="bubble him">생일 축하해 ♡</div>
    <div class="bubble him">오늘 하루는 내가 다 예약했으니까 기대해.</div>
    <div class="bubble him">빨리 보고 싶다.</div>
  </div>
  <div class="quick-replies">
    <button onclick="quickChat('나도 보고 싶어.')">나도 보고 싶어 ♡</button>
    <button onclick="quickChat('오늘 뭐 준비했는데?')">뭐 준비했어?</button>
    <button onclick="quickChat('사쿠야도 오늘 예쁘게 하고 와.')">너도 예쁘게 하고 와</button>
    <button onclick="quickChat('사랑해.')">사랑해</button>
  </div>
  <div class="chat-input">
    <input id="chatInput" placeholder="메시지를 입력해 주세요..." onkeydown="if(event.key==='Enter')sendChat()">
    <button onclick="sendChat()">전송</button>
  </div>
</section>

<!-- SCHEDULE -->
<section class="panel" id="schedulePanel">
  <div class="section-label">OUR DATE PLAN</div>
  <div class="card">
    <h3 style="font-weight:normal;color:#85576d;margin-top:0">오늘의 데이트 일정 ♡</h3>
    <div id="scheduleList"></div>
  </div>
</section>

<!-- MEMORIES -->
<section class="panel" id="memoryPanel">
  <div class="section-label">OUR MEMORIES</div>
  <div class="card">
    <h3 style="font-weight:normal;color:#85576d">오늘의 추억 앨범</h3>
    <p style="font-size:11px;color:#b39ba6">함께한 순간들이 하나씩 쌓여가고 있어.</p>
    <div id="memoryList"></div>
  </div>
</section>

<!-- PRESENT -->
<section class="panel" id="giftPanel">
  <div class="section-label">A PRESENT FOR YOU</div>
  <div class="card gift">
    <div class="gift-icon">🎁</div>
    <h3>사쿠야가 준비한 선물</h3>
    <p id="giftDescription">
      아직 공개되지 않은 선물이 있어.<br>
      오늘의 이야기를 조금 더 진행해 봐.
    </p>
    <div id="giftUnlocked" style="display:none">
      <div style="font-size:42px;margin:20px">💐</div>
      <h3>너를 위한 작은 선물들</h3>
      <p>꽃다발 · 커플 액세서리 · 특별한 선물 · 손편지</p>
    </div>
  </div>
</section>

<div class="footer-note">MADE WITH LOVE · OUR SPECIAL DAY ♡</div>
</main>

<nav class="bottom-nav">
  <button class="tab active" onclick="showTab('storyPanel',this)">
    <span class="ico">♡</span>STORY
  </button>
  <button class="tab" onclick="showTab('chatPanel',this)">
    <span class="ico">✉</span>CHAT
  </button>
  <button class="tab" onclick="showTab('schedulePanel',this)">
    <span class="ico">▦</span>PLAN
  </button>
  <button class="tab" onclick="showTab('memoryPanel',this)">
    <span class="ico">▧</span>MEMORY
  </button>
  <button class="tab" onclick="showTab('giftPanel',this)">
    <span class="ico">♔</span>GIFT
  </button>
</nav>

<div class="modal-bg" id="modal">
  <div class="modal">
    <div style="font-size:40px">♡</div>
    <h2 id="modalTitle">SAKUYA</h2>
    <p id="modalText"></p>
    <button onclick="closeModal()">확인</button>
  </div>
</div>

</div>

<script>
/* ======================================
   STORY DATA : 22 CHAPTERS
====================================== */

const chapters = [

{
time:"08:00",label:"BIRTHDAY MORNING",tag:"BIRTHDAY",
title:"생일의 시작 — 첫 번째 연락",
place:"주인공의 방",
story:`11월의 아침은 생각보다 조용했다.

창문 사이로 들어오는 희미한 빛이 방 안을 천천히 채우고 있었다. 아직 잠에서 완전히 깨어나지 못한 채 이불 속에 누워 있던 순간, 침대 옆 휴대전화가 짧게 진동했다.

화면에는 익숙한 이름이 떠 있었다.

사쿠야.

자정이 지난 뒤에도 연락이 없었던 것은 아니었다. 하지만 아침에 눈을 뜨자마자 가장 먼저 확인한 사람이 그라는 사실은 여전히 기분 좋은 일이었다.

[사쿠야]
생일 축하해 ♡

[사쿠야]
일어났어?

[사쿠야]
오늘은 진짜 내가 하루 종일 데리고 다닐 거야.

잠시 뒤 메시지가 하나 더 도착했다.

[사쿠야]
그러니까 예쁘게 하고 나와.
오늘은 내가 특별히 신경 좀 썼거든.

평소보다 들뜬 말투였다. 무엇을 준비했는지 물어보고 싶었지만, 그는 쉽게 알려줄 생각이 없어 보였다.

오늘 하루가 어떻게 흘러갈지 아직은 알 수 없었다.

다만 한 가지는 분명했다.

오늘은 사쿠야와 함께 보내는 날이었다.`,
choices:[
["아침부터 이렇게 설레게 하면 어떡해.","사쿠야가 웃으며 오늘은 아직 시작도 안 했다고 답한다.",3],
["뭐 준비했는지 미리 알려주면 안 돼?","절대 안 된다며 비밀이라고 대답한다.",1],
["나도 보고 싶었어. 빨리 만나자.","사쿠야가 자기도 그렇다며 보고 싶다고 답한다.",5]
],
memory:"생일 아침, 사쿠야에게 받은 첫 번째 축하 메시지."
},

{
time:"09:00",label:"GETTING READY",tag:"PREPARATION",
title:"준비하는 시간 — 오늘은 조금 특별하게",
place:"주인공의 방",
story:`옷장 문을 열어 놓은 채 한참을 고민했다.

평소라면 크게 신경 쓰지 않았을 선택이었다. 하지만 오늘은 조금 달랐다. 사쿠야를 만나는 날이라는 사실만으로도 평소에 입던 옷들이 어딘가 부족하게 느껴졌다.

몇 번이나 옷을 갈아입고 나서야 마음에 드는 조합을 찾았다.

거울 앞에 서서 머리를 정리하던 중 휴대전화가 다시 울렸다.

[사쿠야]
아직 준비 중이야?

[사쿠야]
나 거의 다 했는데.

잠시 뒤 사진 한 장이 도착했다. 외출할 준비를 마친 사쿠야의 셀카였다.

평소보다 조금 신경 쓴 듯한 옷차림이었다.

[사쿠야]
